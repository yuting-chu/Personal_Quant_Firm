# ==========================================
# Personal Quant Office - 環境變數範本
# 本檔案僅供結構參考，實際金鑰請填寫於 .env（本地）或 Streamlit Cloud Secrets（雲端）
# ==========================================

# Google Gemini API 金鑰（用於 AI 總經與市場情緒分析）
GEMINI_API_KEY=your_gemini_api_key_here

# FRED (Federal Reserve Economic Data) API 金鑰（用於總經數據串接）
FRED_API_KEY=your_fred_api_key_here
